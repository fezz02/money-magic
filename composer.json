{
    "name": "fezz/money-magic",
    "description": "Generate consistent Brick\\Money accessors for Eloquent \"money\" fields stored as minor units (ints). Define money mappings once, avoid floats, keep currency handling centralized, and optionally scaffold mappings via Artisan for clean, type-safe monetary domain code.",
    "keywords": [
        "laravel",
        "eloquent",
        "money",
        "brick-money",
        "casts",
        "accessors",
        "currency",
        "value-object"
    ],
    "homepage": "https://github.com/fezz/money-magic",
    "license": "MIT",
    "authors": [
        {
            "name": "fezz",
            "email": "info@fezz.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "brick/money": "^0.11.0",
        "illuminate/contracts": "^11.0||^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "peckphp/peck": "^0.3.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Fezz\\MoneyMagic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fezz\\MoneyMagic\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "rector",
            "pint"
        ],
        "test:type-coverage": "pest --parallel --type-coverage --min=100",
        "test:refactor": [
            "rector --dry-run"
        ],
        "test:lint": [
            "pint --test"
        ],
        "test:unit": "pest --parallel --coverage --min=100",
        "test:types": "phpstan",
        "test:typos": "peck",
        "test": [
            "@test:typos",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fezz\\MoneyMagic\\MoneyMagicServiceProvider"
            ],
            "aliases": {
                "MoneyMagic": "Fezz\\MoneyMagic\\Facades\\MoneyMagic"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}